{
	"schemaVersion": 1,
	"id": "mco-goto",
	"version": "${version}",
	"name": "MCO Goto",
	"description": "Client-side MinecraftOnline wiki location lookup and teleport automation.",
	"authors": [
		"JesusMRS05"
	],
	"contact": {
		"homepage": "https://github.com/JesusMRS05",
		"sources": "https://github.com/JesusMRS05/MCOGoto"
	},
	"license": "CC0-1.0",
	"icon": "assets/mco-goto/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"com.github.jesusmrs05.MCOGoto"
		],
		"client": [
			"com.github.jesusmrs05.client.MCOGotoClient"
		],
		"modmenu": [
			"com.github.jesusmrs05.client.config.MCOGotoModMenu"
		]
	},
	"mixins": [
		"mco-goto.mixins.json",
		{
			"config": "mco-goto.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*",
		"malilib": "*",
		"modmenu": "*"
	},
	"recommends": {
		"malilib": "*",
		"modmenu": "*"
	}
}